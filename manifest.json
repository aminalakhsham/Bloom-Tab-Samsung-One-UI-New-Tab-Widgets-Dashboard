{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "topSites",
    "search",
    "alarms",
    "notifications",
    "contextMenus",
    "favicon",
    "geolocation",
    "offscreen",
    "idle",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "optional_permissions": [
    "bookmarks",
    "history",
    "tabs",
    "tabGroups",
    "sessions",
    "downloads",
    "downloads.open"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://air-quality-api.open-meteo.com/*",
    "https://www.bing.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "add-to-home": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "__MSG_cmdAddToHome__"
    },
    "quick-capture": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "__MSG_cmdQuickCapture__"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdSidePanel__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "addsite.html",
        "capture.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
